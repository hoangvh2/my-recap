<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass card: translucent tint, a soft highlight on the top half, and a light edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/widget_bg_start" android:endColor="@color/widget_bg_end" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/widget_glass_shine" android:endColor="#00FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/widget_glass_edge" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
